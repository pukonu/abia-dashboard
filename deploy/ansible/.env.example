# Abia Executive Dashboard — where and how to deploy (read by Ansible via group_vars/all.yml).
# Copy to .env and fill in. .env is gitignored; this example is committed.
# The app's own runtime secrets are a separate file: DEPLOY_APP_ENV_FILE.

# SSH target (the shared EC2 host that also runs Lawyers Deck)
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=ubuntu
DEPLOY_SSH_KEY=~/.ssh/your-key.pem

# The one folder on the server that holds everything
DEPLOY_ROOT=/home/ubuntu/containers/abia-dashboard

# Public hostnames: the web dashboard, the PWA, and the Let's Encrypt contact
DEPLOY_DOMAIN=dashboard.abiaworkspace.com
DEPLOY_PWA_DOMAIN=pwa-dashboard.abiaworkspace.com
DEPLOY_ACME_EMAIL=you@example.com
# Extra hostnames that serve the web dashboard as-is (comma-separated; each needs an A record)
DEPLOY_ALIASES=

# Production app env (Supabase URL/keys, DATABASE_URL, SendGrid, Gemini, CRON_SECRET, …),
# relative to this folder. Start from ../../.env.example; gitignored.
DEPLOY_APP_ENV_FILE=.env.production

# The PWA's source folder, relative to this folder
DEPLOY_PWA_DIR=../../../pwa

# Loopback port nginx proxies to, and the container's memory cap (shared host;
# Lawyers Deck uses 7301)
DEPLOY_APP_PORT=7401
DEPLOY_MEM_LIMIT=768m

# Releases (images and PWA builds) kept on the server for rollback
DEPLOY_KEEP_RELEASES=5
