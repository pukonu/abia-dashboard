# {{ ansible_managed }}
# Abia Executive Dashboard on a shared Docker host. Runs from {{ deploy_root }}
# next to other projects: the host's nginx terminates TLS, the app publishes on
# 127.0.0.1 only, and the container has a memory cap so it cannot starve its
# neighbours. The PWA is static files served by the host nginx (pwa/current).
#
# IMAGE_TAG comes from ./.env (written by site.yml / rollback.yml); app secrets
# from ./app.env. Images are loaded with `docker load`, so there is no registry
# (pull_policy: never).
name: abia-dashboard

services:
  web:
    image: {{ image_name }}:${IMAGE_TAG:?set IMAGE_TAG in .env}
    pull_policy: never
    restart: unless-stopped
    env_file: app.env
    environment:
      NODE_ENV: production
      NODE_OPTIONS: --max-old-space-size={{ (mem_limit | regex_replace('m$', '') | int * 0.75) | int }}
    ports:
      - "127.0.0.1:{{ app_port }}:7401"
    # Reach the host's own Postgres as host.docker.internal (PGHOST in app.env).
    extra_hosts:
      - "host.docker.internal:host-gateway"
    mem_limit: {{ mem_limit }}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:7401/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
